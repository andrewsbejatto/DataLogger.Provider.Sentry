# Copie para .env e preencha. NÃO versione o .env.

# openssl rand -hex 32
SECRET_KEY=troque-me

POSTGRES_PASSWORD=troque-me-tambem

# Precisa bater exatamente com o domínio público (com https://, sem barra no fim).
GLITCHTIP_DOMAIN=https://erros.suaempresa.com.br

# Remetente dos alertas.
DEFAULT_FROM_EMAIL=erros@suaempresa.com.br

# Formato do EMAIL_URL:
#   smtp://usuario:senha@smtp.provedor.com:587
#   submission://usuario:senha@smtp.provedor.com:587   (STARTTLS)
#   smtps://usuario:senha@smtp.provedor.com:465        (TLS implícito)
# Senha com caractere especial precisa ser url-encoded (@ vira %40, etc).
# Deixe consolemail:// enquanto estiver testando: o e-mail sai no log do container.
EMAIL_URL=consolemail://

# Dias de retenção dos eventos (issues).
RETENTION_DAYS=90

# Aba Logs. Comece curto e vá subindo depois de medir o volume real —
# 50 instalações mandando log de rotina crescem MUITO mais rápido que erros.
LOG_HOT_DAYS=7
LOG_RETENTION_DAYS=30
